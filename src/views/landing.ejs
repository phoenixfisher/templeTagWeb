<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Temple Tag</title>
  <style>
    /* Reset and base styles */
    * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    }

    body {
    font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background-color: #f9f9f9;
    color: #333;
    line-height: 1.6;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    }

    /* Header and navigation */
    header {
    background-color: #005b8f;
    color: white;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .brand img {
      height: 44px;
      width: auto;
      display: block;
    }

    header h1 {
      font-size: 1.5rem;
    }

    nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    }

    nav a {
    color: white;
    text-decoration: none;
    font-weight: 500;
    }

    nav a:hover {
    text-decoration: underline;
    }

    /* Hero section */
    .hero {
        text-align: center;
        padding: 4rem 2rem;
        background: linear-gradient(135deg, #007bbf, #4fc3f7);
        color: white;
    }
    
    .hero h2 {
        font-size: 2rem;
        margin-bottom: 1rem;
    }
    
    .hero p {
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }
    
    .primary-btn {
        background-color: white;
        color: #007bbf;
        border: none;
        padding: 0.75rem 1.5rem;
        border-radius: 6px;
        font-size: 1rem;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }
    
    .primary-btn:hover {
        background-color: #e0f7fa;
    }
    
    /* Features */
    .features {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        padding: 2rem;
        flex-grow: 1;
    }
    
    .feature-card {
        background-color: white;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
    }
    
    .feature-card h3 {
        color: #007bbf;
        margin-bottom: 0.5rem;
    }
    
    /* How Section */
    .section { padding: 2rem; }

    .list {
      max-width: 900px; margin: 0 auto; display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;
    }

    .list .item {
      background: white; border-radius: 10px; padding: 1rem;
      box-shadow: 0 2px 6px rgba(0,0,0,0.06);
    }

    .item h4 { color: #007bbf; margin-bottom: 0.3rem; }
    
    /* Footer */
    footer {
        background-color: #005b8f;
    color: white;
    text-align: center;
    padding: 1rem 0;
    margin-top: auto;
    font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <header>
    <div class="brand">
      <img src="/LightTransparentTempleIcon.png" alt="Temple Tag logo" />
      <h1>Temple Tag</h1>
    </div>
    <nav>
      <ul>
        <li><a href="#">Home</a></li>
        <li><a href="#">Temples</a></li>
        <li><a href="#">Goals</a></li>
        <li><a href="#">Sign In</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero">
      <h2>Track Your Temple Visits</h2>
      <p>Discover, tag, and complete your temple goals across the world.</p>
      <button class="primary-btn">Get Started</button>
    </section>

    <section class="features">
      <div class="feature-card">
        <h3>Temples</h3>
        <p>Explore all temples and filter by location. Tap to view details and mark visits.</p>
      </div>
      <div class="feature-card">
        <h3>Custom Goals</h3>
        <p>Set themed goals like visiting all temples in Utah or across the U.S.</p>
      </div>
      <div class="feature-card">
        <h3>Progress Tracking</h3>
        <p>Visualize your achievements and see how far you’ve come!</p>
      </div>
      <div class="feature-card">
        <h3>Profile</h3>
        <p>Sign in and keep your visits and goals synced across devices.</p>
      </div>
    </section>

    <!-- HOW IT WORKS (simple 1-2-3) -->
    <section class="section" id="how" aria-labelledby="how-title">
      <h3 id="how-title" style="text-align:center; color:#007bbf; margin-bottom:1rem;">How it works</h3>
      <div class="list">
        <div class="item">
          <h4>1) Sign in</h4>
          <p>Create your account or continue with your email. Your profile stores your home temple and display name.</p>
        </div>
        <div class="item">
          <h4>2) Mark visits</h4>
          <p>Search and open temple pages to mark them visited. We keep a simple history so you can remember when you went.</p>
        </div>
        <div class="item">
          <h4>3) Build missions</h4>
          <p>Add multiple temples to a single goal, or start from a template (All in Utah, All in USA, etc.). Watch your completion grow.</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <p>© 2025 Temple Tag — Built with purpose and inspiration.</p>
  </footer>
</body>
</html>
