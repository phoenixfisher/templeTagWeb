<% const safeFilters = (typeof filters !== "undefined" && filters) ? filters : { q: "", country: "", statuses: [], appointments: false }; %>
<% const safeCountries = (typeof countries !== "undefined" && countries) ? countries : []; %>

<section class="page">
  <form class="stack" method="GET" action="/temples">
    <div class="row-between">
      <div class="stack">
        <p class="eyebrow">Explore Temples</p>
        <h2>Browse every temple worldwide</h2>
        <p class="muted">Search by name, city, or country to find the temples you want to track.</p>
      </div>
      <label class="input-group" for="temple-search">
        <span>Search</span>
        <input
          class="input"
          id="temple-search"
          type="search"
          name="q"
          placeholder="Try “Utah” or “Accra”"
          value="<%= safeFilters.q || '' %>"
        />
      </label>
    </div>

    <% if (error_message) { %>
      <div class="error"><%= error_message %></div>
    <% } %>

    <% const buildPageLink = (targetPage) => {
      const qs = new URLSearchParams();
      if (safeFilters.q) qs.set("q", safeFilters.q);
      if (safeFilters.country) qs.set("country", safeFilters.country);
      if (safeFilters.appointments) qs.set("appointments", "1");
      if (safeFilters.statuses && safeFilters.statuses.length) {
        safeFilters.statuses.forEach(s => qs.append("status", s));
      }
      qs.set("page", targetPage);
      return "/temples?" + qs.toString();
    }; %>

    <% if (totalPages > 1) { %>
      <nav class="pagination">
        <% const prev = page > 1 ? page - 1 : null; %>
        <% const next = page < totalPages ? page + 1 : null; %>
        <a class="page-btn" href="<%= buildPageLink(prev || 1) %>" aria-disabled="<%= !prev %>">Prev</a>
        <span class="page-indicator">Page <%= page %> of <%= totalPages %></span>
        <a class="page-btn" href="<%= buildPageLink(next || totalPages) %>" aria-disabled="<%= !next %>">Next</a>
      </nav>
    <% } %>

    <div class="temple-layout">
      <!-- Filters (always visible) -->
      <aside class="card filters">
        <input type="hidden" name="page" value="1" />
        <div class="stack">
          <strong>Status</strong>
          <% const statusList = ["dedicated","under_construction","announced"]; %>
          <% statusList.forEach(s => { %>
            <label>
              <input
                type="checkbox"
                name="status"
                class="filter-status"
                value="<%= s %>"
                <%= (!safeFilters.statuses.length || safeFilters.statuses.includes(s)) ? "checked" : "" %>
              >
              <%= s.charAt(0).toUpperCase() + s.replace("_"," ").slice(1) %>
            </label>
          <% }) %>
        </div>

        <div class="stack">
          <strong>Country</strong>
          <select id="country" class="input" name="country">
            <option value="">All countries</option>
            <% safeCountries.forEach(c => { %>
              <option value="<%= c %>" <%= safeFilters.country === c ? "selected" : "" %>><%= c %></option>
            <% }) %>
          </select>
        </div>

        <label>
          <input type="checkbox" id="has-appointments" name="appointments" value="1" <%= safeFilters.appointments ? "checked" : "" %>>
          Has appointments
        </label>

        <div class="row-between" style="align-items:center; gap:0.5rem; margin-top:0.75rem; margin-bottom: 0;">
          <button type="submit" class="page-btn">Apply filters</button>
          <a class="primary-btn" href="/temples">Clear</a>
        </div>
      </aside>

      <div>
        <% if (!temples || temples.length === 0) { %>
          <p class="muted center">No temples to show right now.</p>
        <% } else { %>
          <!-- Temples -->
          <div class="card-grid" id="temple-grid">
            <% temples.forEach((temple) => { 
              const locationParts = [temple.city, temple.state, temple.country].filter(Boolean);
              const statusLabel = (temple.status || "unknown").replace(/_/g, " "); %>
              <article class="card temple-card">
                <div class="card-media" style="<%= temple.photoThumb ? `background-image: url('${temple.photoThumb}')` : '' %>"></div>
                <div class="card-body">
                  <div class="row-between" style="align-items: center;">
                    <h3><%= temple.name %></h3>
                    <span class="pill <%= temple.status || 'unknown' %>"><%= statusLabel %></span>
                  </div>
                  <p><strong><%= locationParts.join(", ") || "Location coming soon" %></strong></p>
                  <p class="muted"><%= temple.address || "Address TBA" %></p>
                  <div class="card-links">
                    <% if (temple.website) { %>
                      <a href="<%= temple.website %>" target="_blank" rel="noopener noreferrer">Temple details</a>
                    <% } %>
                    <% if (temple.appointments) { %>
                      <a href="<%= temple.appointments %>" target="_blank" rel="noopener noreferrer">Schedule</a>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </form>
</section>
