<section class="page">
  <div class="row-between">
    <div class="stack">
      <p class="eyebrow">Explore Temples</p>
      <h2>Browse every temple worldwide</h2>
      <p class="muted">Search by name, city, or country to find the temples you want to track.</p>
    </div>
    <label class="input-group" for="temple-search">
      <span>Search</span>
      <input class="input" id="temple-search" type="search" name="q" placeholder="Try “Utah” or “Accra”" />
    </label>
  </div>

  <% if (error_message) { %>
    <div class="error"><%= error_message %></div>
  <% } %>

  <% if (!temples || temples.length === 0) { %>
    <p class="muted center">No temples to show right now.</p>
  <% } else { %>
    <div class="card-grid" id="temple-grid">
      <% temples.forEach((temple) => { 
        const locationParts = [temple.city, temple.state, temple.country].filter(Boolean);
        const searchIndex = [temple.name, temple.city, temple.state, temple.country, temple.status].filter(Boolean).join(" ").toLowerCase();
        const statusLabel = (temple.status || "unknown").replace(/_/g, " ");
      %>
        <article class="card" data-search="<%= searchIndex %>">
          <div class="card-media" style="<%= temple.photoThumb ? `background-image: url('${temple.photoThumb}')` : '' %>"></div>
          <div class="card-body">
            <div class="row-between" style="align-items: center;">
              <h3><%= temple.name %></h3>
              <span class="pill <%= temple.status || 'unknown' %>"><%= statusLabel %></span>
            </div>
            <p><strong><%= locationParts.join(", ") || "Location coming soon" %></strong></p>
            <p class="muted"><%= temple.address || "Address TBA" %></p>
            <div class="card-links">
              <% if (temple.website) { %>
                <a href="<%= temple.website %>" target="_blank" rel="noopener noreferrer">Temple details</a>
              <% } %>
              <% if (temple.appointments) { %>
                <a href="<%= temple.appointments %>" target="_blank" rel="noopener noreferrer">Schedule</a>
              <% } %>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } %>
</section>

<script>
(() => {
  const searchInput = document.getElementById("temple-search");
  const cards = document.querySelectorAll(".temple-card");

  if (!searchInput || !cards.length) return;

  searchInput.addEventListener("input", (event) => {
    const query = event.target.value.trim().toLowerCase();
    cards.forEach((card) => {
      const haystack = card.getAttribute("data-search") || "";
      card.style.display = haystack.includes(query) ? "" : "none";
    });
  });
})();
</script>
