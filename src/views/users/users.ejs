<section class="page">
  <div class="row-between" style="align-items: center;">
    <div class="stack">
      <p class="eyebrow">Users</p>
      <h2>Registered accounts</h2>
      <p class="muted">Basic list of usernames and levels. Passwords are never shown.</p>
    </div>
  </div>

  <% if (error_message) { %>
    <div class="error"><%= error_message %></div>
  <% } %>

  <% if (!users || users.length === 0) { %>
    <p class="muted">No users found.</p>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Level</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach((u) => { %>
            <tr>
              <td><%= u.id %></td>
              <td><%= u.username %></td>
              <td><%= u.level || "N/A" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
