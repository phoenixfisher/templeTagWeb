<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Create Account</title>

    <style>
        /* =====================
           PAGE BASE
        ====================== */
        body {
            margin: 0;
            min-height: 100vh;
            background: #f4f6fb;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
        }

        /* =====================
           AUTH CARD
        ====================== */
        .auth {
            width: 100%;
            max-width: 400px;
            background: #ffffff;
            padding: 32px;
            border-radius: 10px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
        }

        .auth h2 {
            margin-bottom: 20px;
            text-align: center;
            font-size: 1.6rem;
            color: #222;
        }

        /* =====================
           FORM
        ====================== */
        .auth-form {
            display: flex;
            flex-direction: column;
        }

        .auth-form label {
            margin-top: 14px;
            margin-bottom: 6px;
            font-size: 0.9rem;
            color: #555;
        }

        .auth-form input {
            padding: 10px 12px;
            font-size: 1rem;
            border-radius: 6px;
            border: 1px solid #ccc;
            outline: none;
            transition: border 0.2s ease, box-shadow 0.2s ease;
        }

        .auth-form input:focus {
            border-color: #4f7cff;
            box-shadow: 0 0 0 2px rgba(79, 124, 255, 0.15);
        }

        /* =====================
           ERROR MESSAGE
        ====================== */
        .error {
            margin-bottom: 14px;
            padding: 10px;
            background: #fdecea;
            color: #b42318;
            border-radius: 6px;
            font-size: 0.9rem;
            text-align: center;
        }

        /* =====================
           BUTTONS
        ====================== */
        .primary-btn {
            margin-top: 22px;
            padding: 12px;
            font-size: 1rem;
            font-weight: 600;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            background-color: #4f7cff;
            color: #ffffff;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }

        .primary-btn:hover {
            background-color: #3e66d6;
        }

        .primary-btn:active {
            transform: translateY(1px);
        }

        .full-width {
            width: 100%;
        }

        /* =====================
           FOOTER LINKS
        ====================== */
        .auth-footer {
            margin-top: 18px;
            text-align: center;
            font-size: 0.85rem;
            color: #555;
        }

        .auth-footer a {
            color: #4f7cff;
            text-decoration: none;
            font-weight: 500;
        }
    </style>
</head>

<body>

    <section class="auth">
        <h2>Create Account</h2>

        <% if (error_message) { %>
            <div class="error"><%= error_message %></div>
        <% } %>

        <form action="/create-account" method="POST" class="auth-form">

            <label for="username">Username</label>
            <input
                id="username"
                type="text"
                name="username"
                required
            >

            <label for="password">Password</label>
            <input
                id="password"
                type="password"
                name="password"
                required
            >

            <button type="submit" class="primary-btn full-width">
                Create Account
            </button>

        </form>

        <div class="auth-footer">
            Already have an account?
            <a href="/login">Sign in</a>
        </div>
    </section>

</body>
</html>
